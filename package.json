{
  "name": "minimax-h3-studio",
  "version": "7.1.0",
  "private": true,
  "productName": "Minimax H3 Studio",
  "description": "Локальная студия генерации кинематографичных видео со звуком на базе модели MiniMax H3 (ComfyUI + Electron).",
  "author": "MiniMax H3 Studio",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "node scripts/build.mjs",
    "build:default": "next build --webpack",
    "start": "node server.js",
    "desktop": "node scripts/launch-electron.mjs electron/main.js",
    "icons": "node scripts/make-icons.mjs",
    "prepare:electron": "node scripts/prepare-electron.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "clean": "node scripts/clean.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "electron": "^44.9.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
