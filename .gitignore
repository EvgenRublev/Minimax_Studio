/upscale/jobs/
/upscale/logs/

# locally staged reference uploads (ComfyUI offline fallback)
/.local-input

# python bytecode cache
__pycache__/

# bundled runtimes and binaries (hundreds of MB, не для git: GitHub не принимает файлы >100 МБ)
/runtime/
/stt/
/upscale/bin/
/tools/ck_pkg/

