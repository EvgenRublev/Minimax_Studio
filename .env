# ComfyUI backend URL
COMFY_URL=http://127.0.0.1:8188
# Backend root folder (portable ComfyUI: официальное ядро + python_embeded).
# Fallback only — the folder set in Settings (config.ini [comfy] comfy_dir)
# takes priority. (правка 905) Старые установки (ComfyUI-Easy-Install)
# подхватываются автоматически, если новой папки нет.
COMFY_ROOT=./ComfyUI
